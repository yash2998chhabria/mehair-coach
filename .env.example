PUBLIC_BASE_URL=http://localhost:8787
# Render sets RENDER_EXTERNAL_URL automatically; local development can ignore it.
RENDER_EXTERNAL_URL=
# Local development defaults to SQLite. Hosted free deploys should use Turso/libSQL:
# DATABASE_URL=libsql://your-db-org.turso.io
# LIBSQL_AUTH_TOKEN=...
DATABASE_URL=sqlite:///./data/mehair-coach.sqlite3
LIBSQL_AUTH_TOKEN=
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/oauth/callback/google
SYNC_INCREMENTAL_LOOKBACK_DAYS=2
SYNC_INCREMENTAL_OVERLAP_HOURS=2
SYNC_MIN_INTERVAL_MINUTES=15
SYNC_ON_CONNECT=true
SYNC_METRIC_TIMEOUT_SECONDS=4
SYNC_REQUEST_BUDGET_SECONDS=16
SYNC_METRIC_PAGE_LIMIT=4
SYNC_METRIC_CONCURRENCY=6
SYNC_METRIC_RECORD_LIMIT=600
SYNC_ABANDONED_AFTER_MINUTES=5
